---
import Base from '../layouts/Base.astro';
import Capa from '../components/Capa.astro';
import Fileira from '../components/Fileira.astro';
import ProfCard from '../components/ProfCard.astro';
import Logo from '../components/Logo.astro';
import Icone from '../components/Icone.astro';
import SlideVitrine from '../components/SlideVitrine.astro';
import { cursos, professores, totais, relacionados, type Curso } from '../lib/catalogo';
import { config, linkAviso } from '../lib/config';
import { acessoCompleto } from '../lib/precos';
import { url } from '../lib/formatar';
import sorteioJs from '../scripts/vitrine-sorteio.js?raw';

const cfg = config();
const lista = await cursos();
const profs = (await professores()).filter((p) => p.cursos.length > 0);
const tot = await totais();
const porSlug = new Map(lista.map((c) => [c.slug, c]));
// Vitrine (carrossel do topo): todos os cursos com imagem entram no sorteio, que acontece no navegador
// a cada visita (src/scripts/vitrine-sorteio.js). destaque_home e lançamento dão mais chance de sair.
const noSorteio = lista.filter((c) => c.horizontal || c.professor?.cena);
const fixos = cfg.vitrine.fixos.filter((s) => noSorteio.some((c) => c.slug === s));
const quantidade = Math.min(cfg.vitrine.quantidade, noSorteio.length);
const peso = (c: Curso) => 1 + (c.destaque ? 1.5 : 0) + (c.lancamento ? 1 : 0);
const relVitrine = new Map<string, string[]>();
for (const c of noSorteio) relVitrine.set(c.slug, (await relacionados(c, 6)).map((r) => r.slug));
// sem JavaScript, aparece um slide só: o 1º fixo, ou o 1º com destaque_home
const padrao = noSorteio.find((c) => c.slug === fixos[0]) ?? noSorteio.find((c) => c.destaque) ?? noSorteio[0];
// o script vai dentro da página; sem os comentários e os recuos, fica mais leve
const sorteio = sorteioJs
  .replace(/\/\*[\s\S]*?\*\//g, '')
  .replace(/^\s*\/\/.*$/gm, '')
  .replace(/^\s+/gm, '');
const novos = lista.filter((c) => c.lancamento);
const trilhas = cfg.trilhas
  .map((t) => ({ ...t, itens: t.cursos.map((s) => porSlug.get(s)).filter((c): c is NonNullable<typeof c> => Boolean(c)) }))
  .filter((t) => t.itens.length > 1);
const areas = cfg.areas
  .map((a) => ({ ...a, itens: lista.filter((c) => c.area === a.nome) }))
  .filter((a) => a.itens.length > 0);
const acesso = acessoCompleto();
const aviso = linkAviso(`Aviso de inscrições: ${cfg.oferta.acesso_titulo}`);
const TEMPO = 8000;
---
<Base titulo={cfg.nome} atual="inicio">
  <h1 class="sr-only">{cfg.nome}: {cfg.slogan}</h1>

  {noSorteio.length > 0 && (
    <section
      class="vitrine"
      data-vitrine
      data-tempo={TEMPO}
      data-quantidade={quantidade}
      data-fixos={fixos.join(' ')}
      data-personalizar={cfg.vitrine.personalizar ? '1' : '0'}
      aria-roledescription="carrossel"
      aria-label="Cursos em destaque"
    >
      {noSorteio.map((c) => (
        <template
          data-destaque
          data-slug={c.slug}
          data-area={c.areaSlug}
          data-profs={[c.professorSlug, ...c.convidados.map((p) => p.slug)].filter(Boolean).join(' ')}
          data-rel={(relVitrine.get(c.slug) ?? []).join(' ')}
          data-peso={peso(c)}
        >
          <SlideVitrine curso={c} />
        </template>
      ))}
      <noscript>
        <SlideVitrine curso={padrao} carregamento="eager" ativo rotuloAria={`Em destaque: ${padrao.titulo}`} />
      </noscript>
      <div class="vitrine__pontos" role="group" aria-label="Escolher destaque" data-pontos></div>
      {/* o sorteio roda aqui mesmo, antes da primeira pintura (fica dentro da seção por causa do CSS ".vitrine + .apos-vitrine") */}
      <script is:inline set:html={sorteio}></script>
    </section>
  )}

  <div class="apos-vitrine">
    <section class="conteiner atalhos" aria-label="Por onde começar">
      <a class="atalho atalho--laranja" href={url('/descubra/')}>
        <span class="atalho__icone" aria-hidden="true"><Icone nome="bussola" /></span>
        <span class="atalho__txt">
          <strong>Descubra qual o curso certo para você!</strong>
          <span>Responda a algumas perguntas rápidas e receba sugestões de cursos e de uma trilha.</span>
        </span>
        <Icone nome="seta-link" class="atalho__seta" />
      </a>
      <a class="atalho" href={url('/quiz/')}>
        <span class="atalho__icone" aria-hidden="true"><Icone nome="pergunta" /></span>
        <span class="atalho__txt">
          <strong>Teste seu conhecimento</strong>
          <span>Escolha um tema e responda a 5, 10 ou 20 perguntas tiradas dos cursos.</span>
        </span>
        <Icone nome="seta-link" class="atalho__seta" />
      </a>
    </section>

    {novos.length > 0 && (
      <Fileira titulo="Lançamentos">
        {novos.map((c) => <Capa curso={c} />)}
      </Fileira>
    )}

    {trilhas.map((t) => (
      <Fileira titulo={t.titulo} descricao={t.descricao}>
        {t.itens.map((c, i) => (
          <div class="passo">
            <span class="passo__num" aria-hidden="true">{i + 1}</span>
            <Capa curso={c} />
          </div>
        ))}
      </Fileira>
    ))}

    {areas.map((a) => (
      <Fileira titulo={a.nome} descricao={a.descricao} link={url(`/areas/${a.slug}/`)} textoLink="Ver a área">
        {a.itens.map((c) => <Capa curso={c} />)}
      </Fileira>
    ))}

    <Fileira titulo="Professores" descricao="Quem ensina na Tutora." link={url('/professores/')} textoLink="Ver todos">
      {profs.map((p) => <ProfCard prof={p} tamanhos="212px" />)}
    </Fileira>
  </div>

  <section class="secao secao--clara" style="margin-top:clamp(40px,6vw,80px)">
    <div class="conteiner manifesto">
      <div>
        <span class="sobretitulo">Tutora</span>
        <h2 class="titulo-display" style="margin:14px 0 18px">
          <span class="leve">{cfg.home.titulo_regular}</span><br />{cfg.home.titulo_destaque}
        </h2>
        <p class="texto-2" style="font-size:1.08rem;max-width:52ch">{cfg.home.subtitulo}</p>
        <form class="busca" action={url('/cursos/')} method="get" role="search" style="margin-top:26px;max-width:560px">
          <Icone nome="busca" />
          <label class="sr-only" for="busca-home">Buscar cursos, temas ou professores</label>
          <input id="busca-home" name="q" type="search" placeholder="Tema, autor ou professor" autocomplete="off" />
        </form>
      </div>
      <div class="numeros">
        <div class="numero"><strong>{tot.cursos}</strong><span>cursos no catálogo</span></div>
        <div class="numero"><strong>{tot.aulas}</strong><span>aulas em vídeo</span></div>
        <div class="numero"><strong>{tot.horas}h</strong><span>de conteúdo</span></div>
        <div class="numero"><strong>{tot.professores}</strong><span>professores</span></div>
      </div>
    </div>
  </section>

  <section class="secao" id="acesso-completo" style="padding-bottom:0">
    <span id="assinatura" aria-hidden="true"></span>
    <div class="conteiner">
      <div class="chamada">
        <div>
          <span class="sobretitulo">{cfg.oferta.acesso_titulo}</span>
          <h2 style="margin-top:12px">Todos os {tot.cursos} cursos numa assinatura só.</h2>
          <p>
            {acesso.preco
              ? `Por ${acesso.preco}${acesso.parcelado ? ` ${acesso.parcelado}` : ''}, você estuda o catálogo inteiro da ${cfg.nome}: ${tot.aulas} aulas com ${tot.professores} professores.`
              : `Estude o catálogo inteiro da ${cfg.nome} com um único plano.`}
          </p>
        </div>
        <div class="chamada__acoes">
          {acesso.disponivel ? (
            <>
              <a class="botao botao--escuro" href={acesso.link} target="_blank" rel="noopener"><Icone nome="estrela" /> Quero o {cfg.oferta.acesso_titulo}</a>
              {acesso.nomeHotmart && <span class="chamada__nota">Na Hotmart, aparece como “{acesso.nomeHotmart}”.</span>}
            </>
          ) : (
            <>
              <span class="chamada__breve">{cfg.oferta.texto_sem_link}</span>
              {aviso && (
                <a class="botao botao--escuro" href={aviso} target={/^https?:/.test(aviso) ? '_blank' : undefined} rel={/^https?:/.test(aviso) ? 'noopener' : undefined}>
                  <Icone nome="email" /> {cfg.oferta.texto_aviso}
                </a>
              )}
            </>
          )}
        </div>
        <Logo variante="simbolo" class="chamada__simbolo" titulo="" />
      </div>
    </div>
  </section>
</Base>

<script>
  const vitrine = document.querySelector<HTMLElement>('[data-vitrine]');
  if (vitrine) {
    const slides = [...vitrine.querySelectorAll<HTMLElement>('[data-slide]')];
    const pontos = [...vitrine.querySelectorAll<HTMLButtonElement>('[data-ponto]')];
    const tempo = Number(vitrine.dataset.tempo || 8000);
    const calmo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let atual = 0;
    let timer: number | undefined;
    const mostrar = (i: number) => {
      atual = (i + slides.length) % slides.length;
      slides.forEach((s, j) => {
        s.classList.toggle('ativo', j === atual);
        s.inert = j !== atual;
      });
      pontos.forEach((p, j) => {
        p.classList.remove('ativo');
        if (j === atual) {
          void p.offsetWidth; // reinicia a animação da barrinha
          p.classList.add('ativo');
          p.setAttribute('aria-current', 'true');
        } else p.removeAttribute('aria-current');
      });
    };
    const iniciar = () => {
      if (calmo || slides.length < 2) return;
      parar();
      timer = window.setInterval(() => mostrar(atual + 1), tempo);
    };
    const parar = () => timer && window.clearInterval(timer);
    slides.forEach((s, j) => (s.inert = j !== 0));
    pontos.forEach((p, j) =>
      p.addEventListener('click', () => {
        mostrar(j);
        iniciar();
      }),
    );
    vitrine.addEventListener('mouseenter', parar);
    vitrine.addEventListener('mouseleave', iniciar);
    vitrine.addEventListener('focusin', parar);
    iniciar();
  }
</script>
