---
/**
 * "Descubra seu curso": questionário curto que sugere cursos e uma trilha.
 * Perguntas, pesos, motivos e trilhas ficam em conteudo/descubra.md (editável pela equipe).
 */
import Base from '../../layouts/Base.astro';
import Capa from '../../components/Capa.astro';
import Icone from '../../components/Icone.astro';
import { cursos, nomesProfessores } from '../../lib/catalogo';
import { descubra } from '../../lib/paginas-extras';
import { config } from '../../lib/config';
import { url, plural } from '../../lib/formatar';

const d = descubra();
// Planilha "Meus leads" (configuracoes.yaml): sem o link, o site não pede contato nem envia nada.
const leads = config().leads;
const comLeads = /^https:\/\/script\.google(usercontent)?\.com\//.test(leads.link_planilha);
const lista = await cursos();
const porSlug = new Map(lista.map((c) => [c.slug, c]));

// etiquetas de cada curso + duração (curto/medio/longo), calculada pela soma das aulas
const PESO_DURACAO = 2;
const dadosCursos: Record<string, { tags: Record<string, number>; p: string }> = {};
for (const [slug, tags] of Object.entries(d.cursos)) {
  const c = porSlug.get(slug);
  if (!c) continue;
  const dur = c.minutos <= d.duracao.curto_ate_min ? 'curto' : c.minutos >= d.duracao.longo_a_partir_min ? 'longo' : 'medio';
  dadosCursos[slug] = { tags: { ...tags, [dur]: (tags[dur] ?? 0) + PESO_DURACAO }, p: c.professorSlug };
}
const usados = new Set([
  ...Object.keys(dadosCursos),
  ...d.pontoDePartida.filter((s) => porSlug.has(s)),
  ...d.trilhas.flatMap((t) => t.cursos.filter((s) => porSlug.has(s))),
]);
const dados = JSON.stringify({
  perguntas: d.perguntas,
  motivos: d.motivos,
  cursos: dadosCursos,
  pontoDePartida: d.pontoDePartida.filter((s) => porSlug.has(s)),
  trilhas: d.trilhas.map((t) => ({ ...t, cursos: t.cursos.filter((s) => porSlug.has(s)) })).filter((t) => t.cursos.length > 1),
  titulos: Object.fromEntries([...usados].map((s) => [s, porSlug.get(s)!.titulo])),
  leads: comLeads ? leads.link_planilha : '',
}).replace(/</g, '\\u003c');
const nPerguntas = d.perguntas.length;
---
<Base titulo="Descubra seu curso" descricao={d.subtitulo || d.titulo} topoSolido atual="descubra">
  <div class="conteiner descubra" data-descubra data-fase="perguntas">
    <script type="application/json" data-dados set:html={dados}></script>
    <!-- no computador: título à esquerda e perguntas à direita, tudo numa tela só -->
    <div class="dc-palco">
      <header class="cab-pagina cab-pagina--compacta dc-cab-pagina">
        <span class="sobretitulo">Descubra seu curso</span>
        <h1>{d.titulo}</h1>
        {d.subtitulo && <p>{d.subtitulo}</p>}
        <p class="texto-3 dc-leva"><Icone nome="relogio" /> Cerca de 1 minuto · até {nPerguntas} perguntas</p>
      </header>

      <section class="dc-tela" data-tela="perguntas" aria-label="Perguntas">
        <div class="dc-caixa">
          <div class="dc-cab">
            <div class="dc-progresso" aria-hidden="true"><i data-barra></i></div>
            <span class="chip" data-passo></span>
          </div>
          <div data-etapa="pergunta">
            <h2 class="dc-pergunta" data-pergunta tabindex="-1"></h2>
            <p class="dc-ajuda" data-ajuda></p>
            <div class="dc-opcoes" data-opcoes></div>
          </div>
          {comLeads && (
            <form class="dc-contato" data-etapa="contato" hidden novalidate>
              <h2 class="dc-pergunta" tabindex="-1" data-contato-titulo>{leads.titulo}</h2>
              <p class="dc-ajuda">{leads.texto}</p>
              <div class="dc-campos">
                <label class="dc-campo">
                  <span>Nome <small>(opcional)</small></span>
                  <input name="nome" type="text" autocomplete="name" maxlength="80" />
                </label>
                <label class="dc-campo">
                  <span>E-mail <small>(opcional)</small></span>
                  <input name="email" type="email" autocomplete="email" inputmode="email" maxlength="120" aria-describedby="dc-erro-email" />
                </label>
                <label class="dc-isca" aria-hidden="true">Deixe em branco <input name="site" type="text" tabindex="-1" autocomplete="off" /></label>
              </div>
              <p class="dc-erro" id="dc-erro-email" data-erro hidden>Confira o e-mail: parece que falta alguma coisa.</p>
              <p class="dc-privacidade">{leads.aviso} <a href={url('/privacidade/')}>Política de privacidade</a>.</p>
            </form>
          )}
          <div class="dc-nav">
            <button class="botao botao--vidro" type="button" data-voltar><Icone nome="seta-esq" /> Voltar</button>
            <button class="botao botao--laranja" type="button" data-continuar></button>
          </div>
        </div>
      </section>
    </div>

    <section class="dc-tela" data-tela="resultado" hidden aria-label="Sugestões">
      <span class="sobretitulo">Resultado</span>
      <h2 class="titulo-secao dc-titulo" data-titulo-resultado tabindex="-1">Os cursos que mais combinam com você</h2>
      <div class="dc-principal" data-principal></div>
      <div data-bloco-outros>
        <h3 class="dc-sub">Também combinam com você</h3>
        <div class="dc-outros" data-outros></div>
      </div>
      <div class="dc-trilha" data-bloco-trilha>
        <h3 class="dc-sub" data-trilha-nome></h3>
        <p class="texto-2" data-trilha-desc></p>
        <div class="dc-trilha__passos" data-trilha></div>
      </div>
      <div class="dc-acoes">
        <button class="botao botao--laranja" type="button" data-refazer><Icone nome="refazer" /> Refazer o teste</button>
        <a class="botao botao--vidro" href={url('/cursos/')}><Icone nome="grade" /> Ver todos os cursos</a>
        <a class="botao botao--vidro" href={url('/quiz/')}><Icone nome="pergunta" /> Testar seus conhecimentos</a>
      </div>
    </section>

    {lista.filter((c) => usados.has(c.slug)).map((c) => (
      <template data-card={c.slug}>
        <article class="dc-card">
          <div class="dc-card__capa"><Capa curso={c} tamanhos="(max-width: 700px) 120px, 240px" /></div>
          <div class="dc-card__txt">
            <span class="dc-card__rotulo" data-rotulo></span>
            <a class="dc-card__titulo" href={url(`/cursos/${c.slug}/`)}>{c.titulo}</a>
            <span class="dc-card__meta">{[nomesProfessores(c), plural(c.nAulas, 'aula'), c.duracaoTexto].filter(Boolean).join(' · ')}</span>
            <p class="dc-card__frase">{c.frase}</p>
            <div class="dc-card__porque" data-porque hidden>
              <strong>Por que este curso</strong>
              <ul data-motivos></ul>
            </div>
            <a class="link-seta" href={url(`/cursos/${c.slug}/`)}>Conhecer o curso <Icone nome="seta-link" /></a>
          </div>
        </article>
      </template>
    ))}
  </div>
</Base>

<script>
  import { lembrarDescubra } from '../../scripts/interesses';

  interface Opcao {
    texto: string;
    pontos: Record<string, number>;
    marca?: string;
    exclusiva?: boolean;
  }
  interface Pergunta {
    id: string;
    pergunta: string;
    ajuda: string;
    tipo: 'uma' | 'varias';
    maximo: number;
    mostrarSe: string;
    opcoes: Opcao[];
  }
  interface Dados {
    perguntas: Pergunta[];
    motivos: Record<string, string>;
    cursos: Record<string, { tags: Record<string, number>; p: string }>;
    pontoDePartida: string[];
    trilhas: { nome: string; descricao: string; cursos: string[] }[];
    titulos: Record<string, string>;
    /** endereço da planilha "Meus leads" (vazio = não envia nada) */
    leads: string;
  }

  const raiz = document.querySelector<HTMLElement>('[data-descubra]');
  if (raiz) {
    const dados: Dados = JSON.parse(raiz.querySelector('[data-dados]')?.textContent || '{}');
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => raiz.querySelector<T>(s)!;
    const respostas = new Map<string, Set<number>>(); // id da pergunta → índices escolhidos
    const form = raiz.querySelector<HTMLFormElement>('[data-etapa="contato"]');
    const comContato = Boolean(form && dados.leads);
    const sessao = Math.random().toString(36).slice(2, 10);
    let passo = 0; // índice nas perguntas visíveis; um a mais = etapa do contato (quando existe)
    let jaInteragiu = false; // na primeira pergunta, o foco fica onde a pessoa está

    const marcas = () => {
      const m = new Set<string>();
      for (const p of dados.perguntas) {
        for (const i of respostas.get(p.id) ?? []) {
          const marca = p.opcoes[i]?.marca;
          if (marca) m.add(marca);
        }
      }
      return m;
    };
    const visiveis = () => {
      const m = marcas();
      return dados.perguntas.filter((p) => !p.mostrarSe || m.has(p.mostrarSe));
    };
    const naEtapaContato = () => comContato && passo >= visiveis().length;

    // Fases: perguntas | resultado. No celular, depois da primeira resposta o cabeçalho sai de cena
    // (data-andamento) para cada pergunta caber na tela; a página volta ao topo a cada passo.
    const mostrarTela = (nome: string) => {
      raiz.querySelectorAll<HTMLElement>('[data-tela]').forEach((t) => (t.hidden = t.dataset.tela !== nome));
      raiz.dataset.fase = nome;
      if (window.scrollY > 0) window.scrollTo({ top: 0 });
    };

    function desenhar() {
      const lista = visiveis();
      const total = lista.length + (comContato ? 1 : 0);
      passo = Math.min(passo, total - 1);
      raiz!.toggleAttribute('data-andamento', passo > 0);
      $('[data-barra]').style.width = `${Math.round((passo / total) * 100)}%`;
      $('[data-voltar]').hidden = passo === 0;

      if (naEtapaContato()) {
        $('[data-passo]').textContent = 'Para terminar';
        $('[data-etapa="pergunta"]').hidden = true;
        form!.hidden = false;
        $('[data-continuar]').textContent = 'Ver minhas sugestões →';
        $('[data-contato-titulo]').focus({ preventScroll: true });
        if (window.scrollY > 0) window.scrollTo({ top: 0 });
        return;
      }
      if (form) form.hidden = true;
      $('[data-etapa="pergunta"]').hidden = false;

      const p = lista[passo];
      const escolhidas = respostas.get(p.id) ?? new Set<number>();
      $('[data-passo]').textContent = `Pergunta ${passo + 1} de ${lista.length}`;
      const titulo = $('[data-pergunta]');
      titulo.textContent = p.pergunta;
      const ajuda = $('[data-ajuda]');
      ajuda.textContent = p.ajuda;
      ajuda.hidden = !p.ajuda;
      const caixa = $('[data-opcoes]');
      caixa.innerHTML = '';
      caixa.setAttribute('role', p.tipo === 'uma' ? 'radiogroup' : 'group');
      // respostas curtas cabem em duas colunas no celular
      caixa.classList.toggle('dc-opcoes--curtas', p.opcoes.every((o) => o.texto.length <= 26));
      caixa.setAttribute('aria-label', p.pergunta);
      p.opcoes.forEach((o, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'dc-opcao';
        b.setAttribute('role', p.tipo === 'uma' ? 'radio' : 'checkbox');
        b.setAttribute('aria-checked', String(escolhidas.has(i)));
        b.innerHTML = '<span class="dc-opcao__marca" aria-hidden="true"></span><span></span>';
        (b.lastElementChild as HTMLElement).textContent = o.texto;
        b.addEventListener('click', () => escolher(p, i));
        caixa.appendChild(b);
      });
      atualizarContinuar(p);
      if (jaInteragiu) {
        titulo.focus({ preventScroll: true });
        if (window.scrollY > 0) window.scrollTo({ top: 0 });
      }
      jaInteragiu = true;
    }

    function atualizarContinuar(p: Pergunta) {
      const n = respostas.get(p.id)?.size ?? 0;
      const ultimo = passo === visiveis().length - 1 && !comContato;
      $('[data-continuar]').textContent = n === 0 ? 'Pular' : ultimo ? 'Ver minhas sugestões →' : 'Continuar →';
    }

    function escolher(p: Pergunta, i: number) {
      const atual = new Set(respostas.get(p.id) ?? []);
      if (p.tipo === 'uma') {
        atual.clear();
        atual.add(i);
      } else if (atual.has(i)) {
        atual.delete(i);
      } else {
        if (p.opcoes[i].exclusiva) atual.clear();
        else p.opcoes.forEach((o, j) => o.exclusiva && atual.delete(j));
        if (p.maximo && atual.size >= p.maximo) {
          // no limite: a escolha mais antiga dá lugar à nova
          const primeira = atual.values().next().value;
          if (primeira !== undefined) atual.delete(primeira);
        }
        atual.add(i);
      }
      respostas.set(p.id, atual);
      raiz!.querySelectorAll<HTMLButtonElement>('.dc-opcao').forEach((b, j) => b.setAttribute('aria-checked', String(atual.has(j))));
      atualizarContinuar(p);
      if (p.tipo === 'uma') window.setTimeout(avancar, 260);
    }

    // ── contato (opcional) ──
    const emailValido = (e: string) => /^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(e);
    function contatoOk(): boolean {
      if (!form) return true;
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const erro = $('[data-erro]');
      const ok = !email || emailValido(email);
      erro.hidden = ok;
      (form.elements.namedItem('email') as HTMLInputElement).setAttribute('aria-invalid', String(!ok));
      if (!ok) (form.elements.namedItem('email') as HTMLInputElement).focus();
      return ok;
    }

    function avancar() {
      const lista = visiveis();
      if (naEtapaContato()) {
        if (contatoOk()) resultado();
        return;
      }
      if (passo < lista.length - 1 || comContato) {
        passo++;
        desenhar();
      } else resultado();
    }

    // ── cálculo ──
    function perfil(): Record<string, number> {
      const soma: Record<string, number> = {};
      for (const p of visiveis()) {
        for (const i of respostas.get(p.id) ?? []) {
          for (const [t, v] of Object.entries(p.opcoes[i]?.pontos ?? {})) soma[t] = (soma[t] ?? 0) + v;
        }
      }
      return soma;
    }
    const nota = (slug: string, pf: Record<string, number>) =>
      Object.entries(dados.cursos[slug]?.tags ?? {}).reduce((s, [t, peso]) => s + (pf[t] ?? 0) * peso, 0);
    const motivos = (slug: string, pf: Record<string, number>) =>
      Object.entries(dados.cursos[slug]?.tags ?? {})
        .map(([t, peso]) => [t, (pf[t] ?? 0) * peso] as const)
        .filter(([t, v]) => v > 0 && dados.motivos[t])
        .sort((a, b) => b[1] - a[1])
        .slice(0, 3)
        .map(([t]) => dados.motivos[t]);

    function cartao(slug: string, rotulo: string, porque: string[], classe = ''): HTMLElement | null {
      const t = raiz!.querySelector<HTMLTemplateElement>(`template[data-card="${slug}"]`);
      if (!t) return null;
      const el = t.content.firstElementChild!.cloneNode(true) as HTMLElement;
      if (classe) el.classList.add(classe);
      el.querySelector('[data-rotulo]')!.textContent = rotulo;
      if (porque.length) {
        const ul = el.querySelector('[data-motivos]')!;
        porque.forEach((m) => {
          const li = document.createElement('li');
          li.textContent = m.charAt(0).toUpperCase() + m.slice(1);
          ul.appendChild(li);
        });
        (el.querySelector('[data-porque]') as HTMLElement).hidden = false;
      }
      return el;
    }

    // ── planilha "Meus leads": uma linha por pessoa que chega ao resultado ──
    function enviarLead(sugeridos: string[], trilha: string) {
      if (!dados.leads) return;
      const campo = (n: string) => ((form?.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
      if (campo('site')) return; // campo-isca: só robô preenche
      const email = emailValido(campo('email')) ? campo('email') : '';
      const linha: Record<string, string> = { nome: campo('nome'), email, aceita_emails: email ? 'sim' : '' };
      let respondeu = false;
      for (const p of visiveis()) {
        linha[p.id] = [...(respostas.get(p.id) ?? [])].map((i) => p.opcoes[i]?.texto ?? '').join(' | ');
        if (linha[p.id]) respondeu = true;
      }
      if (!respondeu && !linha.nome && !email) return; // pulou tudo e não deixou contato: nada a guardar
      sugeridos.slice(0, 3).forEach((s, i) => (linha[`curso_${i + 1}`] = dados.titulos[s] ?? s));
      linha.trilha = trilha;
      const q = new URLSearchParams(location.search);
      let veioDe = '';
      try {
        const r = document.referrer ? new URL(document.referrer).hostname : '';
        veioDe = r && r !== location.hostname ? r : '';
      } catch {
        /* referência inválida: ignora */
      }
      linha.origem = ['utm_source', 'utm_medium', 'utm_campaign'].map((k) => q.get(k)).filter(Boolean).join(' / ') || veioDe;
      linha.dispositivo = window.matchMedia('(max-width: 760px)').matches ? 'celular' : 'computador';
      linha.sessao = sessao;
      try {
        // "no-cors": a planilha recebe o texto e o site não precisa esperar a resposta
        fetch(dados.leads, { method: 'POST', mode: 'no-cors', keepalive: true, body: JSON.stringify(linha) }).catch(() => {});
      } catch {
        /* sem internet: segue sem gravar */
      }
    }

    function resultado() {
      const pf = perfil();
      const ranking = Object.keys(dados.cursos)
        .map((s) => ({ s, n: nota(s, pf) }))
        .filter((x) => x.n > 0)
        .sort((a, b) => b.n - a.n);
      // no máximo dois cursos do mesmo professor entre os três sugeridos
      const escolhidos: string[] = [];
      const porProf = new Map<string, number>();
      for (const { s } of ranking) {
        const p = dados.cursos[s].p;
        if ((porProf.get(p) ?? 0) >= 2) continue;
        escolhidos.push(s);
        porProf.set(p, (porProf.get(p) ?? 0) + 1);
        if (escolhidos.length === 3) break;
      }
      const semPerfil = escolhidos.length === 0;
      const finais = semPerfil ? dados.pontoDePartida.slice(0, 3) : escolhidos;

      $('[data-titulo-resultado]').textContent = semPerfil
        ? 'Alguns bons pontos de partida'
        : 'Os cursos que mais combinam com você';
      const principal = $('[data-principal]');
      principal.innerHTML = '';
      const c0 = cartao(finais[0], semPerfil ? 'Para começar' : 'O mais indicado para você', semPerfil ? [] : motivos(finais[0], pf), 'dc-card--grande');
      if (c0) principal.appendChild(c0);
      const outros = $('[data-outros]');
      outros.innerHTML = '';
      finais.slice(1).forEach((s) => {
        const c = cartao(s, semPerfil ? 'Para começar' : 'Também indicado', semPerfil ? [] : motivos(s, pf));
        if (c) outros.appendChild(c);
      });
      $('[data-bloco-outros]').hidden = finais.length < 2;

      // trilha: a de maior nota média
      const trilhas = dados.trilhas
        .map((t) => ({ t, media: t.cursos.reduce((s, c) => s + nota(c, pf), 0) / t.cursos.length }))
        .sort((a, b) => b.media - a.media);
      const bloco = $('[data-bloco-trilha]');
      let nomeTrilha = '';
      if (!semPerfil && trilhas.length && trilhas[0].media > 0) {
        const { t } = trilhas[0];
        nomeTrilha = t.nome;
        $('[data-trilha-nome]').textContent = `Uma trilha para você: ${t.nome}`;
        $('[data-trilha-desc]').textContent = t.descricao;
        const passos = $('[data-trilha]');
        passos.innerHTML = '';
        t.cursos.forEach((s, i) => {
          const modelo = raiz!.querySelector<HTMLTemplateElement>(`template[data-card="${s}"]`);
          const poster = modelo?.content.querySelector('.poster')?.cloneNode(true) as HTMLElement | undefined;
          if (!poster) return;
          const passo = document.createElement('div');
          passo.className = 'passo';
          passo.innerHTML = `<span class="passo__num" aria-hidden="true">${i + 1}</span>`;
          passo.appendChild(poster);
          passos.appendChild(passo);
        });
        bloco.hidden = false;
      } else bloco.hidden = true;

      enviarLead(finais, nomeTrilha);
      // só no navegador da pessoa: a vitrine da home passa a puxar para estes cursos
      if (!semPerfil) lembrarDescubra([...finais, ...ranking.map((x) => x.s)]);
      mostrarTela('resultado');
      $('[data-titulo-resultado]').focus({ preventScroll: true });
    }

    $('[data-continuar]').addEventListener('click', avancar);
    // Enter num campo do contato vale como "Ver minhas sugestões"
    form?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      avancar();
    });
    form?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' && (ev.target as HTMLElement).tagName === 'INPUT') {
        ev.preventDefault();
        avancar();
      }
    });
    $('[data-voltar]').addEventListener('click', () => {
      if (passo > 0) {
        passo--;
        desenhar();
      }
    });
    $('[data-refazer]').addEventListener('click', () => {
      respostas.clear();
      passo = 0;
      jaInteragiu = false;
      mostrarTela('perguntas');
      desenhar();
    });
    desenhar();
  }
</script>
