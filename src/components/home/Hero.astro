---
/**
 * Hero.astro — bloco principal da home.
 */
import { LINKS } from '~/config/site';
---

<section class="relative overflow-hidden">
  <!-- Atmosfera: blobs sutis em laranja e verde-agua (sem ser gradiente saturado) -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-32 -right-32 w-[40rem] h-[40rem] rounded-full bg-tutora-laranja/10 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-[36rem] h-[36rem] rounded-full bg-tutora-verde-agua/8 blur-3xl"></div>
  </div>

  <div class="container-tutora relative py-20 sm:py-28 lg:py-32 text-center max-w-4xl">
    <h1 class="font-display font-extrabold text-display-xl text-white tracking-tight">
      Uma formação humana<br />que vai além dos diplomas.
    </h1>
    <p class="mt-7 font-sans text-base sm:text-lg lg:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">
      Mais conhecimento melhora as decisões que tomamos no dia a dia e transforma nossas vidas.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="#catalogo" class="btn-secondary">Ver catálogo</a>
      <a
        href={LINKS.assinaturaHotmart}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        Assinar agora
      </a>
    </div>
  </div>
</section>
