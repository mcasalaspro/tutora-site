---
/**
 * CursosRelacionados.astro — grid de até 4 cursos.
 */
import type { CollectionEntry } from 'astro:content';
import CardCurso from '~/components/cards/CardCurso.astro';

interface Props {
  cursos: CollectionEntry<'cursos'>[];
}

const { cursos } = Astro.props;
if (!cursos || cursos.length === 0) return null;
---

<section class="container-tutora py-10">
  <h2 class="font-display font-extrabold text-display-md mb-6 text-white">
    Cursos relacionados
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {cursos.slice(0, 4).map((c) => <CardCurso curso={c} />)}
  </div>
</section>
