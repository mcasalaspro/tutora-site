---
/**
 * OQueVaiAprender.astro — lista em 2 colunas no desktop.
 */
interface Props {
  itens: string[];
}
const { itens } = Astro.props;
---

<section class="container-tutora py-10">
  <h2 class="font-display font-extrabold text-display-md mb-6 text-white">
    O que você vai aprender
  </h2>
  <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-3 max-w-5xl">
    {itens.map((item) => (
      <li class="flex gap-3 items-start">
        <span class="flex-shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-tutora-laranja" aria-hidden="true"></span>
        <span class="font-sans text-base text-white/85 leading-relaxed">{item}</span>
      </li>
    ))}
  </ul>
</section>
