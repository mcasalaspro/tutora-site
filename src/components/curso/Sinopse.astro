---
/**
 * Sinopse.astro — texto editorial da sinopse longa, em prosa.
 */
interface Props {
  sinopse: string;
}
const { sinopse } = Astro.props;

const paragrafos = sinopse.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<section class="container-tutora py-10">
  <div class="max-w-prose prose-tutora">
    <h2 class="font-display font-extrabold text-display-md mb-5 text-white">
      Sobre o curso
    </h2>
    {paragrafos.map((p) => <p>{p}</p>)}
  </div>
</section>
