---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '../styles/global.css';
import montUrl from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import montTituloUrl from '@fontsource/montserrat/files/montserrat-latin-700-normal.woff2?url';
import Topo from '../components/Topo.astro';
import Rodape from '../components/Rodape.astro';
import { config } from '../lib/config';
import { url } from '../lib/formatar';

interface Props {
  titulo: string;
  descricao?: string;
  imagem?: string;
  tipo?: 'website' | 'article';
  topoSolido?: boolean;
  atual?: 'inicio' | 'cursos' | 'professores' | 'quiz' | 'descubra' | '';
  jsonLd?: object | object[];
  semIndexar?: boolean;
  /** O que esta página diz sobre o interesse de quem a abre (guardado só no navegador; ver src/scripts/interesses.ts). */
  interesse?: { curso?: string; area?: string; professor?: string };
}
const cfg = config();
const {
  titulo,
  descricao = cfg.descricao,
  imagem,
  tipo = 'website',
  topoSolido = false,
  atual = '',
  jsonLd,
  semIndexar = false,
  interesse = {},
} = Astro.props;

const tituloCompleto = titulo === cfg.nome ? `${cfg.nome} · ${cfg.slogan}` : `${titulo} · ${cfg.nome}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
const og = imagem
  ? (imagem.startsWith('http') ? imagem : Astro.site ? new URL(imagem, Astro.site).toString() : imagem)
  : Astro.site
    ? new URL(url('/marca/og-padrao.jpg'), Astro.site).toString()
    : url('/marca/og-padrao.jpg');
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ldTexto = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    {semIndexar && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#171726" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preload" href={montTituloUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montUrl} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:site_name" content={`${cfg.nome} · ${cfg.slogan}`} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={og} />
    {ld.map((o) => <script type="application/ld+json" set:html={ldTexto(o)} />)}
  </head>
  <body
    class:list={{ 'com-topo-solido': topoSolido }}
    data-interesse-curso={interesse.curso || undefined}
    data-interesse-area={interesse.area || undefined}
    data-interesse-professor={interesse.professor || undefined}
  >
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Topo solido={topoSolido} atual={atual} />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
    <slot name="depois" />
    <script>
      // Guarda, só neste navegador, os cursos, áreas e professores que a pessoa abre (a vitrine da home usa isso).
      import { registrarVisita, registrarForte } from '../scripts/interesses';

      const d = document.body.dataset;
      if (d.interesseCurso) registrarVisita('cursos', d.interesseCurso);
      if (d.interesseArea) registrarVisita('areas', d.interesseArea);
      if (d.interesseProfessor) registrarVisita('professores', d.interesseProfessor);
      const curso = d.interesseCurso;
      if (curso) {
        // botões de compra e de "avise-me" dos cartões, e o play dos vídeos: interesse forte neste curso
        document.addEventListener(
          'click',
          (ev) => {
            const alvo = ev.target instanceof Element ? ev.target.closest('.oferta a.botao, [data-video]') : null;
            if (alvo) registrarForte(curso);
          },
          { capture: true },
        );
      }
    </script>
  </body>
</html>
