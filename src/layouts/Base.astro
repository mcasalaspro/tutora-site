---
import '@fontsource/baloo-2/400.css';
import '@fontsource/baloo-2/600.css';
import '@fontsource/baloo-2/800.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '../styles/global.css';
import balooUrl from '@fontsource/baloo-2/files/baloo-2-latin-800-normal.woff2?url';
import montUrl from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import Topo from '../components/Topo.astro';
import Rodape from '../components/Rodape.astro';
import { config } from '../lib/config';
import { url } from '../lib/formatar';

interface Props {
  titulo: string;
  descricao?: string;
  imagem?: string;
  tipo?: 'website' | 'article';
  topoSolido?: boolean;
  atual?: 'inicio' | 'cursos' | 'professores' | '';
  jsonLd?: object | object[];
  semIndexar?: boolean;
}
const cfg = config();
const {
  titulo,
  descricao = cfg.descricao,
  imagem,
  tipo = 'website',
  topoSolido = false,
  atual = '',
  jsonLd,
  semIndexar = false,
} = Astro.props;

const tituloCompleto = titulo === cfg.nome ? `${cfg.nome} · ${cfg.slogan}` : `${titulo} · ${cfg.nome}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
const og = imagem
  ? (imagem.startsWith('http') ? imagem : Astro.site ? new URL(imagem, Astro.site).toString() : imagem)
  : Astro.site
    ? new URL(url('/marca/og-padrao.jpg'), Astro.site).toString()
    : url('/marca/og-padrao.jpg');
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ldTexto = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    {semIndexar && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#171726" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preload" href={balooUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montUrl} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:site_name" content={`${cfg.nome} · ${cfg.slogan}`} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={og} />
    {ld.map((o) => <script type="application/ld+json" set:html={ldTexto(o)} />)}
  </head>
  <body class:list={{ 'com-topo-solido': topoSolido }}>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Topo solido={topoSolido} atual={atual} />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
    <slot name="depois" />
  </body>
</html>
